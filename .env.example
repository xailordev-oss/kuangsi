# copy ເປັນ .env ແລ້ວໃສ່ຄ່າແທ້
DATABASE_URL="mysql://root:<ລະຫັດ>@localhost:3306/kuangsi"

# Auth.js — ສ້າງດ້ວຍ: openssl rand -base64 33
AUTH_SECRET="<random>"
# ເຄື່ອງພັດທະນາ: true · ຕອນ deploy ໃຫ້ຕັ້ງ AUTH_URL="https://<domain>" ແທນ
AUTH_TRUST_HOST=true

# ບ່ອນເກັບຮູບຫຼັກຖານການໂອນ — ຕ້ອງຢູ່ນອກ public/ (ຂໍ້ຕົກລົງ 29) · ຄ່າເລີ່ມຕົ້ນ ./storage/proofs
PROOF_UPLOAD_DIR=

# ໄລຍະທາງ (Phase 9) — OpenRouteService ຟຣີ 2,000 ເສັ້ນທາງ/ວັນ · ສະໝັກ: https://openrouteservice.org/dev/#/signup
# ບໍ່ໃສ່ → ລະບົບໃຊ້ຄ່າປະມານ (ເສັ້ນຊື່ × 1.5) ພ້ອມໝາຍ "ປະມານ" · ຫຼັງໃສ່ key: npm run places:routes
ORS_API_KEY=
