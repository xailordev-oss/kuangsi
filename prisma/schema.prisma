generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model add_ons {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  code            String            @unique(map: "uk_add_ons_code") @db.VarChar(30)
  name_lo         String            @db.VarChar(100)
  name_en         String            @db.VarChar(100)
  name_zh         String?           @db.VarChar(100)
  name_th         String?           @db.VarChar(100)
  price           Decimal           @db.Decimal(12, 2)
  currency        String            @default("LAK") @db.Char(3)
  unit            add_ons_unit      @default(per_person)
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.DateTime(0)
  updated_at      DateTime          @default(now()) @db.DateTime(0)
  booking_add_ons booking_add_ons[]
}

model audit_logs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt?  @db.UnsignedBigInt
  action     String   @db.VarChar(50)
  table_name String?  @db.VarChar(50)
  record_id  BigInt?  @db.UnsignedBigInt
  old_value  Json?
  new_value  Json?
  ip_address String?  @db.VarChar(45)
  created_at DateTime @default(now()) @db.DateTime(0)
  users      users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_audit_user")

  @@index([created_at], map: "idx_audit_created")
  @@index([table_name, record_id], map: "idx_audit_record")
  @@index([user_id], map: "idx_audit_user")
}

model booking_add_ons {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  booking_id BigInt   @db.UnsignedBigInt
  add_on_id  BigInt   @db.UnsignedBigInt
  quantity   Int      @default(1) @db.UnsignedSmallInt
  unit_price Decimal  @db.Decimal(12, 2)
  line_total Decimal  @db.Decimal(12, 2)
  add_ons    add_ons  @relation(fields: [add_on_id], references: [id], onUpdate: NoAction, map: "fk_baddons_addon")
  bookings   bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_baddons_booking")

  @@index([add_on_id], map: "fk_baddons_addon")
  @@index([booking_id], map: "idx_booking_add_ons_booking")
}

model booking_items {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  booking_id     BigInt       @db.UnsignedBigInt
  ticket_type_id BigInt       @db.UnsignedBigInt
  quantity       Int          @db.UnsignedSmallInt
  unit_price     Decimal      @db.Decimal(12, 2)
  line_total     Decimal      @db.Decimal(12, 2)
  bookings       bookings     @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_items_booking")
  ticket_types   ticket_types @relation(fields: [ticket_type_id], references: [id], onUpdate: NoAction, map: "fk_items_ticket_type")

  @@index([ticket_type_id], map: "fk_items_ticket_type")
  @@index([booking_id], map: "idx_booking_items_booking")
}

model bookings {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  booking_code    String            @unique(map: "uk_bookings_code") @db.VarChar(20)
  qr_token        String            @unique(map: "uk_bookings_qr") @db.Char(36)
  customer_id     BigInt?           @db.UnsignedBigInt
  visit_date      DateTime          @db.Date
  time_slot_id    BigInt?           @db.UnsignedBigInt
  subtotal        Decimal           @default(0.00) @db.Decimal(12, 2)
  discount        Decimal           @default(0.00) @db.Decimal(12, 2)
  total_amount    Decimal           @default(0.00) @db.Decimal(12, 2)
  currency        String            @default("LAK") @db.Char(3)
  status          bookings_status   @default(pending)
  channel         bookings_channel  @default(online)
  expires_at      DateTime?         @db.DateTime(0)
  note            String?           @db.Text
  created_by      BigInt?           @db.UnsignedBigInt
  created_at      DateTime          @default(now()) @db.DateTime(0)
  updated_at      DateTime          @default(now()) @db.DateTime(0)
  booking_add_ons booking_add_ons[]
  booking_items   booking_items[]
  customers       customers?        @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_bookings_customer")
  time_slots      time_slots?       @relation(fields: [time_slot_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_bookings_time_slot")
  users           users?            @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_bookings_user")
  check_ins       check_ins[]
  payments        payments[]

  @@index([created_by], map: "fk_bookings_user")
  @@index([customer_id], map: "idx_bookings_customer")
  @@index([status], map: "idx_bookings_status")
  @@index([time_slot_id], map: "idx_bookings_time_slot")
  @@index([visit_date, status], map: "idx_bookings_visit_date")
}

model check_ins {
  id            BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  booking_id    BigInt           @db.UnsignedBigInt
  gate          String           @default("main") @db.VarChar(30)
  scanned_at    DateTime         @default(now()) @db.DateTime(0)
  scanned_by    BigInt?          @db.UnsignedBigInt
  result        check_ins_result @default(ok)
  note          String?          @db.VarChar(255)
  ok_booking_id BigInt?          @unique(map: "uk_check_ins_ok") @db.UnsignedBigInt
  bookings      bookings         @relation(fields: [booking_id], references: [id], onUpdate: NoAction, map: "fk_checkins_booking")
  users         users?           @relation(fields: [scanned_by], references: [id], onUpdate: NoAction, map: "fk_checkins_user")

  @@index([scanned_by], map: "fk_checkins_user")
  @@index([booking_id], map: "idx_check_ins_booking")
  @@index([scanned_at], map: "idx_check_ins_scanned_at")
}

model customers {
  id          BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  full_name   String             @db.VarChar(150)
  phone       String?            @db.VarChar(30)
  email       String?            @db.VarChar(255)
  nationality String?            @db.Char(2)
  id_number   String?            @db.VarChar(50)
  id_type     customers_id_type?
  created_at  DateTime           @default(now()) @db.DateTime(0)
  updated_at  DateTime           @default(now()) @db.DateTime(0)
  bookings    bookings[]

  @@index([email], map: "idx_customers_email")
  @@index([nationality], map: "idx_customers_nationality")
  @@index([phone], map: "idx_customers_phone")
}

model daily_capacity {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  capacity_date DateTime    @db.Date
  time_slot_id  BigInt?     @db.UnsignedBigInt
  max_visitors  Int         @db.UnsignedInt
  booked_count  Int         @default(0) @db.UnsignedInt
  slot_key      BigInt?     @db.UnsignedBigInt
  time_slots    time_slots? @relation(fields: [time_slot_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_capacity_time_slot")

  @@unique([capacity_date, slot_key], map: "uk_capacity_date_slot")
  @@index([time_slot_id], map: "idx_capacity_time_slot")
}

model exchange_rates {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  from_currency  String   @db.Char(3)
  to_currency    String   @db.Char(3)
  rate           Decimal  @db.Decimal(14, 6)
  effective_date DateTime @db.Date
  created_at     DateTime @default(now()) @db.DateTime(0)

  @@unique([from_currency, to_currency, effective_date], map: "uk_rates")
}

model holidays {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  holiday_date DateTime @unique(map: "uk_holidays_date") @db.Date
  name_lo      String   @db.VarChar(100)
  name_en      String?  @db.VarChar(100)
  is_closed    Boolean  @default(true)
}

model operating_hours {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  day_of_week Int      @unique(map: "uk_operating_dow") @db.UnsignedTinyInt
  open_time   DateTime @db.Time(0)
  close_time  DateTime @db.Time(0)
  is_closed   Boolean  @default(false)
}

model payments {
  id             BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  booking_id     BigInt          @db.UnsignedBigInt
  method         payments_method
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("LAK") @db.Char(3)
  exchange_rate  Decimal?        @db.Decimal(14, 6)
  transaction_id String?         @db.VarChar(100)
  proof_url      String?         @db.VarChar(500)
  status         payments_status @default(pending)
  paid_at        DateTime?       @db.DateTime(0)
  refund_amount  Decimal?        @db.Decimal(12, 2)
  refund_reason  String?         @db.VarChar(255)
  refunded_at    DateTime?       @db.DateTime(0)
  raw_response   Json?
  created_at     DateTime        @default(now()) @db.DateTime(0)
  updated_at     DateTime        @default(now()) @db.DateTime(0)
  bookings       bookings        @relation(fields: [booking_id], references: [id], onUpdate: NoAction, map: "fk_payments_booking")

  @@index([booking_id], map: "idx_payments_booking")
  @@index([status], map: "idx_payments_status")
  @@index([transaction_id], map: "idx_payments_txn")
}

model route_cache {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  origin_key   String   @unique(map: "uk_route_cache_origin") @db.VarChar(32)
  distance_km  Decimal  @db.Decimal(8, 2)
  duration_min Int      @db.UnsignedInt
  provider     String   @db.VarChar(32)
  created_at   DateTime @default(now()) @db.DateTime(0)

  @@index([created_at], map: "idx_route_cache_created")
}

model settings {
  setting_key   String   @id @db.VarChar(80)
  setting_value String   @db.Text
  description   String?  @db.VarChar(255)
  updated_by    BigInt?  @db.UnsignedBigInt
  updated_at    DateTime @default(now()) @db.DateTime(0)
  users         users?   @relation(fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_settings_user")

  @@index([updated_by], map: "fk_settings_user")
}

model ticket_types {
  id            BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  code          String                     @unique(map: "uk_ticket_types_code") @db.VarChar(30)
  name_lo       String                     @db.VarChar(100)
  name_en       String                     @db.VarChar(100)
  name_zh       String?                    @db.VarChar(100)
  name_th       String?                    @db.VarChar(100)
  visitor_group ticket_types_visitor_group
  age_group     ticket_types_age_group
  age_min       Int?                       @db.UnsignedTinyInt
  age_max       Int?                       @db.UnsignedTinyInt
  price         Decimal                    @db.Decimal(12, 2)
  currency      String                     @default("LAK") @db.Char(3)
  sort_order    Int                        @default(0) @db.SmallInt
  is_active     Boolean                    @default(true)
  created_at    DateTime                   @default(now()) @db.DateTime(0)
  updated_at    DateTime                   @default(now()) @db.DateTime(0)
  booking_items booking_items[]

  @@index([is_active, visitor_group], map: "idx_ticket_types_active")
}

model time_slots {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  start_time     DateTime         @db.Time(0)
  end_time       DateTime         @db.Time(0)
  max_visitors   Int?             @db.UnsignedInt
  sort_order     Int              @default(0) @db.SmallInt
  is_active      Boolean          @default(false)
  created_at     DateTime         @default(now()) @db.DateTime(0)
  updated_at     DateTime         @default(now()) @db.DateTime(0)
  bookings       bookings[]
  daily_capacity daily_capacity[]

  @@unique([start_time, end_time], map: "uk_time_slots_range")
}

model users {
  id            BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  username      String       @unique(map: "uk_users_username") @db.VarChar(50)
  email         String       @unique(map: "uk_users_email") @db.VarChar(255)
  password_hash String       @db.VarChar(255)
  full_name     String       @db.VarChar(150)
  phone         String?      @db.VarChar(30)
  role          users_role   @default(viewer)
  is_active     Boolean      @default(true)
  last_login_at DateTime?    @db.DateTime(0)
  created_at    DateTime     @default(now()) @db.DateTime(0)
  updated_at    DateTime     @default(now()) @db.DateTime(0)
  audit_logs    audit_logs[]
  bookings      bookings[]
  check_ins     check_ins[]
  settings      settings[]

  @@index([role], map: "idx_users_role")
}

model places {
  id           BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  name_lo      String      @db.VarChar(150)
  name_en      String      @db.VarChar(150)
  name_zh      String?     @db.VarChar(150)
  name_th      String?     @db.VarChar(150)
  type         places_type
  lat          Decimal     @db.Decimal(9, 6)
  lng          Decimal     @db.Decimal(9, 6)
  distance_km  Decimal?    @db.Decimal(8, 2)
  duration_min Int?        @db.UnsignedInt
  is_active    Boolean     @default(true)

  @@index([is_active, type], map: "idx_places_active_type")
}

enum payments_method {
  bcel_one
  ldb
  onepay
  card
  cash
  other
}

enum customers_id_type {
  national_id
  passport
  other
}

enum ticket_types_visitor_group {
  lao
  foreigner
}

enum users_role {
  admin
  cashier
  scanner
  viewer
}

enum ticket_types_age_group {
  adult
  child
  senior
  free
}

enum add_ons_unit {
  per_person
  per_booking
  per_item
}

enum payments_status {
  pending
  success
  failed
  refunded
}

enum bookings_channel {
  online
  gate
  tour_agency
}

enum places_type {
  hotel
  landmark
  airport
}

enum check_ins_result {
  ok
  duplicate
  expired
  invalid
  wrong_date
  unpaid
  cancelled
}

enum bookings_status {
  pending
  verifying
  paid
  used
  cancelled
  expired
}
